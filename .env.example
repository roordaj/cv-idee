# Copy to .env and fill in. Never commit .env.

# Home Assistant (standalone mode; the add-on uses SUPERVISOR_TOKEN instead)
HA_URL=http://homeassistant.local:8123
# Long-lived access token. Used for reading and notify only — never to control devices.
HA_TOKEN=

# SQLite database location
CVIDEE_DB_PATH=./data/cvidee.sqlite

# Optional token for the REST API in standalone mode (empty = no auth)
CVIDEE_API_TOKEN=

# MQTT broker for the HA export via MQTT discovery (standalone mode)
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Log level: trace|debug|info|warning|error
CVIDEE_LOG_LEVEL=info
